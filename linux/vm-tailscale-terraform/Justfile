tailnet_name := env_var_or_default("TAILNET_NAME", "")
tailscale_api_key := env_var_or_default("TAILSCALE_API_KEY", "")
resource_group := env_var_or_default("RESOURCE_GROUP", "")

export TF_VAR_tailnet_name := tailnet_name
export TF_VAR_tailscale_api_key := tailscale_api_key
export TF_VAR_resource_group_name := resource_group
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

default:
    @just --list

# Validate configuration and produce a non-mutating Terraform plan.
validate:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "$TF_VAR_tailnet_name" || -n "$TF_VAR_tailscale_api_key" ]]; then
        : "${TF_VAR_tailnet_name:?Set TAILNET_NAME when TAILSCALE_API_KEY is set}"
        : "${TF_VAR_tailscale_api_key:?Set TAILSCALE_API_KEY when TAILNET_NAME is set}"
    fi
    terraform init -backend=false -input=false -lockfile=readonly
    terraform fmt -check
    terraform validate
    terraform plan -input=false -lock=false -refresh=false
