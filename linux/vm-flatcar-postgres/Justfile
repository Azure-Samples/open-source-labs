    @printf "export PGPASSWORD=''\n"
    @printf "export PGPORT='5432'\n"
    @printf "export PGDATABASE='postgres'\n"
    @printf "export PGUSER='username'\n"

# Print the psql command from the PostgreSQL deployment.
psql-command:
    az deployment group show \
        --name postgres \
        --resource-group "$RESOURCE_GROUP" \
        --output tsv \
        --query "properties.outputs.postgresUrl.value"

# Connect with psql through the latest PostgreSQL Docker image.
psql-docker:
    #!/usr/bin/env bash
    set -euo pipefail
    required=(PGHOST PGPASSWORD PGPORT PGDATABASE PGUSER)
    for variable in "${required[@]}"; do
        if [[ -z "${!variable:-}" ]]; then
            printf '%s not set. This command requires: %s\n' "$variable" "${required[*]}" >&2
            exit 1
        fi
    done

    docker run -it \
        -e PGHOST \
        -e PGPASSWORD \
        -e PGPORT \
        -e PGDATABASE \
        -e PGUSER \
        --rm \
        postgres \
        psql "sslmode=require"

# Remove files created during deployment.
clean:
    rm -f env.sh ignition.json
