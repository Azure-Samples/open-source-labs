default:
    @just --list

resource_group := env_var_or_default("RESOURCE_GROUP", "")
location := env_var_or_default("LOCATION", "eastus")
aks_name := env_var_or_default("AKS_NAME", "aks-kubeflow")

export RESOURCE_GROUP := resource_group
export LOCATION := location
export AKS_NAME := aks_name
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

# Check generated ARM without changing Azure resources.
validate-static:
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    diff -u main.json <(az bicep build --file main.bicep --stdout)

# Check generated ARM and preview the AKS deployment without changing Azure resources.
validate: validate-static
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    : "${RESOURCE_GROUP:?Set RESOURCE_GROUP to an existing validation resource group}"
    az deployment group what-if \
        --resource-group "$RESOURCE_GROUP" \
        --template-file main.bicep \
        --parameters \
            "location=$LOCATION" \
            "clusterName=$AKS_NAME" \
            "kubernetesVersion=$AKS_KUBERNETES_VERSION" \
        --no-pretty-print

# Deploy the AKS cluster at resource-group scope.
deploy-aks:
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    : "${RESOURCE_GROUP:?Set RESOURCE_GROUP to an existing resource group}"
    az deployment group create \
        --resource-group "$RESOURCE_GROUP" \
        --template-file main.bicep \
        --parameters \
            "location=$LOCATION" \
            "clusterName=$AKS_NAME" \
            "kubernetesVersion=$AKS_KUBERNETES_VERSION"

# Get credentials for the AKS cluster.
credentials:
    az aks get-credentials --resource-group "$RESOURCE_GROUP" --name "$AKS_NAME" --admin --overwrite-existing

# Install kubectl through the Azure CLI.
aks-kubectl:
    az aks install-cli

# Install the pinned Kustomize release in /usr/local/bin.
ensure-kustomize:
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    if [[ -z "${SUDO_USER:-}" ]]; then
        printf 'Run this recipe with sudo.\n' >&2
        exit 1
    fi

    case "$(uname -s)-$(uname -m)" in
        Darwin-arm64)
            platform="darwin_arm64"
            ;;
        Darwin-x86_64)
            platform="darwin_amd64"
            ;;
        Linux-aarch64|Linux-arm64)
            platform="linux_arm64"
            ;;
        Linux-x86_64)
            platform="linux_amd64"
            ;;
        *)
            printf 'Unsupported platform: %s-%s\n' "$(uname -s)" "$(uname -m)" >&2
            exit 1
            ;;
    esac

    asset="kustomize_${KUSTOMIZE_VERSION}_${platform}.tar.gz"
    temp_dir="$(mktemp -d)"
    trap 'rm -f "$temp_dir/$asset" "$temp_dir/kustomize"; rmdir "$temp_dir"' EXIT
    curl --fail --location --silent --show-error \
        "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/$asset" \
        --output "$temp_dir/$asset"
    tar -xzf "$temp_dir/$asset" -C "$temp_dir"
    install -m 0755 "$temp_dir/kustomize" /usr/local/bin/kustomize

# Download, verify, and prepare the pinned Kubeflow release.
fetch-kubeflow:
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env

    archive=".cache/community-distribution-${KUBEFLOW_VERSION}.tar.gz"
    release_dir=".cache/community-distribution-${KUBEFLOW_VERSION}"
    temp_archive="${archive}.tmp"
    trap 'rm -f "$temp_archive"' EXIT
    mkdir -p .cache

    curl --fail --location --silent --show-error \
        "https://codeload.github.com/kubeflow/community-distribution/tar.gz/refs/tags/${KUBEFLOW_VERSION}" \
        --output "$temp_archive"
    mv "$temp_archive" "$archive"
    echo "$KUBEFLOW_ARCHIVE_SHA256  $archive" | sha256sum --check --strict

    rm -rf -- "$release_dir"
    mkdir -p "$release_dir"
    tar -xzf "$archive" --strip-components=1 -C "$release_dir"
    cp -R overlay "$release_dir/aks-overlay"

    domain="${DOMAIN:-}"
    requested_dns_label="${DNS_LABEL:-}"
    domain_label_pattern='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
    if [[ -n "$domain" ]] &&
        { (( ${#domain} > 253 )) ||
          [[ ! "$domain" =~ ^${domain_label_pattern}(\.${domain_label_pattern})+$ ]]; }; then
        printf 'DOMAIN must be a lower-case ASCII FQDN without a scheme, path, port, wildcard, or trailing dot.\n' >&2
        exit 1
    fi
    if [[ -n "$requested_dns_label" ]] &&
        [[ ! "$requested_dns_label" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
        printf 'DNS_LABEL must be 1-63 lower-case letters, digits, or hyphens and start and end with a letter or digit.\n' >&2
        exit 1
    fi

    default_dns_label="kubeflow-static-validation"
    default_kubeflow_host="kubeflow-static-validation.eastus.cloudapp.azure.com"
    location="eastus"
    dns_label="${requested_dns_label:-$default_dns_label}"
    azure_host="${dns_label}.${location,,}.cloudapp.azure.com"
    kubeflow_host="${domain:-$azure_host}"
    dex_issuer="https://${kubeflow_host}/dex"
    dex_login_url="https://${kubeflow_host}/dex/auth"
    oauth2_redirect_uri="https://${kubeflow_host}/oauth2/callback"
    if [[ -z "$requested_dns_label" ]]; then
        test "$azure_host" = "$default_kubeflow_host"
    fi

    printf '%s\n' \
        "DNS_LABEL=$dns_label" \
        "KUBEFLOW_HOST=$kubeflow_host" \
        "DEX_ISSUER=$dex_issuer" \
        "DEX_LOGIN_URL=$dex_login_url" \
        "OAUTH2_REDIRECT_URI=$oauth2_redirect_uri" \
        > "$release_dir/aks-overlay/params.env"

    if [[ -f "$release_dir/aks-overlay/patches/dex-config.yaml.in" ]]; then
        sed \
            -e "s|@@DEX_ISSUER@@|$dex_issuer|g" \
            -e "s|@@OAUTH2_REDIRECT_URI@@|$oauth2_redirect_uri|g" \
            "$release_dir/aks-overlay/patches/dex-config.yaml.in" \
            > "$release_dir/aks-overlay/patches/dex-config.yaml"
        ! grep -q '@@' "$release_dir/aks-overlay/patches/dex-config.yaml"
    fi

# Remove the downloaded and extracted Kubeflow release.
clean-cache:
    rm -rf -- .cache

# Install Kubeflow from the pinned release, retrying transient apply failures.
kubeflow: fetch-kubeflow
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    cd ".cache/community-distribution-${KUBEFLOW_VERSION}"
    attempt=1
    while ! kustomize build aks-overlay |
        kubectl apply --server-side --force-conflicts -f -; do
        if (( attempt == 15 )); then
            printf 'Failed after 15 attempts: kustomize build aks-overlay\n' >&2
            exit 1
        fi
        printf 'Retrying to apply resources\n'
        sleep 20
        ((attempt += 1))
    done

# Delete Kubeflow resources defined by the pinned release.
kubeflow-delete: fetch-kubeflow
    #!/usr/bin/env bash
    set -euo pipefail
    source versions.env
    cd ".cache/community-distribution-${KUBEFLOW_VERSION}"
    kustomize build aks-overlay | kubectl delete -f -

# Wait for every Kubeflow pod to become ready.
kubectl-ready:
    #!/usr/bin/env bash
    set -euo pipefail
    namespaces=(
        cert-manager
        istio-system
        auth
        knative-eventing
        knative-serving
        kubeflow
        kubeflow-user-example-com
    )

    check_ready() {
        local namespace
        for namespace in "${namespaces[@]}"; do
            kubectl wait \
                --for=condition=Ready \
                pods \
                --all \
                --namespace "$namespace" \
                --timeout=30s || return
        done
    }

    for attempt in {1..10}; do
        if check_ready; then
            exit 0
        fi
        if (( attempt < 10 )); then
            printf 'attempt %d of 10 failed. waiting 60 seconds.\n' "$attempt"
            sleep 60
        fi
    done

    printf 'exceeded max attempts: 10\n' >&2
    exit 1

# List pods in each Kubeflow namespace.
kubeflow-pods:
    #!/usr/bin/env bash
    set -euo pipefail
    namespaces=(
        cert-manager
        istio-system
        auth
        knative-eventing
        knative-serving
        kubeflow
        kubeflow-user-example-com
    )
    for namespace in "${namespaces[@]}"; do
        kubectl get pods --namespace "$namespace"
    done

# Forward local port 8080 to the Kubeflow ingress gateway.
kubeflow-port:
    kubectl port-forward svc/istio-ingressgateway --namespace istio-system 8080:80

# Restart the Dex deployment.
restart-dex:
    kubectl rollout restart deployment dex --namespace auth

# Deleting a resource group destroys any role assignment scoped to it, so where
# your access is granted at the group scope rather than the subscription, reach
# for this instead of group-delete.

# Empty the resource group, leaving the group itself in place.
group-empty:
    #!/usr/bin/env bash
    set -euo pipefail
    temp_dir="$(mktemp -d)"
    empty_bicep="$temp_dir/empty.bicep"
    trap 'rm -f "$empty_bicep"; rmdir "$temp_dir"' EXIT
    : > "$empty_bicep"

    printf 'Emptying RESOURCE_GROUP %s in 10 seconds.\n' "$RESOURCE_GROUP"
    sleep 10
    az deployment group create \
        --resource-group "$RESOURCE_GROUP" \
        --template-file "$empty_bicep" \
        --mode Complete

[private]
_password-and-hash:
    @cd {{justfile_directory()}}/tools/password && go run .

# Generate a 32-character password and its cost-12 bcrypt hash.
password:
    @just _password-and-hash

# Configure Dex with a generated password and record it in auth.md.
configure-dex:
    #!/usr/bin/env bash
    set -euo pipefail
    config_file="aks/manifests/common/dex/base/config-map.yaml"
    git restore --source=HEAD -- "$config_file" auth.md

    credentials="$(just --quiet _password-and-hash)"
    password="${credentials#Password: }"
    password="${password%%$'\n'*}"
    hash="${credentials##*$'\n'Hash: }"

    python3 -c \
        'import sys; from pathlib import Path; path = Path(sys.argv[1]); old, new = sys.argv[2:]; text = path.read_text(); text.count(old) == 1 or sys.exit(f"expected exactly one occurrence of {old!r} in {path}"); path.write_text(text.replace(old, new))' \
        "$config_file" \
        'hash: $2y$12$4K/VkmDd1q1Orb3xAt82zu8gk7Ad6ReFR4LCP9UeYE90NLiN9Df72' \
        "hash: $hash"

    python3 -c \
        'import sys; from pathlib import Path; path = Path(sys.argv[1]); old, new = sys.argv[2:]; text = path.read_text(); text.count(old) == 1 or sys.exit(f"expected exactly one occurrence of {old!r} in {path}"); path.write_text(text.replace(old, new))' \
        auth.md \
        'Password: 12341234' \
        "Password: $password"

# Configure TLS for the ingress gateway's public IP address.
configure-tls:
    #!/usr/bin/env bash
    set -euo pipefail
    ip="$(kubectl \
        --namespace istio-system \
        get service istio-ingressgateway \
        --output 'jsonpath={.status.loadBalancer.ingress[0].ip}')"
    if [[ -z "$ip" ]]; then
        printf 'The istio-ingressgateway IP address is empty.\n' >&2
        exit 1
    fi
    printf 'IP Address: %s\n' "$ip"

    certificate_file="aks/certificate.yaml"
    git restore --source=HEAD -- "$certificate_file"
    python3 -c \
        'import sys; from pathlib import Path; path = Path(sys.argv[1]); old, new = sys.argv[2:]; text = path.read_text(); text.count(old) == 1 or sys.exit(f"expected exactly one occurrence of {old!r} in {path}"); path.write_text(text.replace(old, new))' \
        "$certificate_file" \
        '192.168.0.5' \
        "$ip"

    python3 -c \
        'import sys; from pathlib import Path; path = Path(sys.argv[1]); old, new = sys.argv[2:]; text = path.read_text(); text.count(old) == 1 or sys.exit(f"expected exactly one occurrence of {old!r} in {path}"); path.write_text(text.replace(old, new))' \
        auth.md \
        'URL: http://localhost:8080' \
        "URL: https://$ip"

    kubectl apply --filename "$certificate_file"

# Wait for the specified number of seconds.
wait seconds:
    @printf 'waiting %ss\n' "{{ seconds }}"
    @sleep "{{ seconds }}"

# Run the complete Kubeflow deployment and configuration sequence.
kubeflow-all: kubeflow kubectl-ready restart-dex configure-tls
