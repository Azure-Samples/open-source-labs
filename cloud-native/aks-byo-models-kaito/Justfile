export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

default:
    @just --list

# Plan the workstation.
validate:
    terraform -chdir=workstation init -backend=false -input=false -lockfile=readonly
    terraform -chdir=workstation fmt -check
    terraform -chdir=workstation validate
    terraform -chdir=workstation plan -input=false -lock=false -refresh=false

# Build the pinned KitOps image. Needs docker, so it is not part of validate.
build:
    docker build --tag labs/kaito-kitops:validate .
