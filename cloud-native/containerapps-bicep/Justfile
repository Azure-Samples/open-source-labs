resource_group := env_var_or_default("RESOURCE_GROUP", "")
location := env_var_or_default("LOCATION", "eastus")

export RESOURCE_GROUP := resource_group
export LOCATION := location
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

default:
    @just --list

# Compile every template, check generated ARM, and preview the deployment.
validate:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${RESOURCE_GROUP:?Set RESOURCE_GROUP to an existing validation resource group}"
    for template in *.bicep; do
        az bicep build --file "$template" --stdout >/dev/null
    done
    for stem in app containerapp main; do
        diff -u "$stem.json" <(az bicep build --file "$stem.bicep" --stdout)
    done
    group_location="$(az group show --name "$RESOURCE_GROUP" --query location -o tsv)"
    for template in containerapp postgres-keyvault; do
        az deployment group what-if \
            --resource-group "$RESOURCE_GROUP" \
            --template-file "$template.bicep" \
            --parameters "location=$group_location" \
            --no-pretty-print
    done
