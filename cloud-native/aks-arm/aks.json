{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "10738095528175143336"
    }
  },
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "aks-arm",
      "metadata": {
        "description": "The name of the Managed Cluster resource."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The location of the Managed Cluster resource."
      }
    },
    "dnsPrefix": {
      "type": "string",
      "metadata": {
        "description": "Optional DNS prefix to use with hosted Kubernetes API server FQDN."
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 1023,
      "metadata": {
        "description": "Disk size (in GB) to provision for each of the agent pool nodes. Specifying 0 applies the default disk size for the VM size."
      }
    },
    "agentCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 50,
      "metadata": {
        "description": "The number of nodes in each agent pool."
      }
    },
    "agentVMSize": {
      "type": "string",
      "defaultValue": "Standard_D2pds_v6",
      "metadata": {
        "description": "The size of the Azure Cobalt 100 Arm-based virtual machines."
      }
    },
    "linuxAdminUsername": {
      "type": "string",
      "metadata": {
        "description": "User name for the Linux virtual machines."
      }
    },
    "sshRSAPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH RSA public key used to access the Linux virtual machines."
      }
    },
    "osSKU": {
      "type": "string",
      "defaultValue": "AzureLinux3",
      "allowedValues": [
        "AzureLinux3",
        "AzureLinux",
        "Ubuntu"
      ],
      "metadata": {
        "description": "The node OS. Azure Linux 3 is the default for this lab."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2026-05-01",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "dnsPrefix": "[parameters('dnsPrefix')]",
        "agentPoolProfiles": [
          {
            "count": "[parameters('agentCount')]",
            "mode": "System",
            "name": "system1",
            "osDiskSizeGB": "[parameters('osDiskSizeGB')]",
            "osSKU": "[parameters('osSKU')]",
            "osType": "Linux",
            "vmSize": "[parameters('agentVMSize')]"
          },
          {
            "count": "[parameters('agentCount')]",
            "mode": "User",
            "name": "user1",
            "osDiskSizeGB": "[parameters('osDiskSizeGB')]",
            "osSKU": "[parameters('osSKU')]",
            "osType": "Linux",
            "vmSize": "[parameters('agentVMSize')]"
          }
        ],
        "linuxProfile": {
          "adminUsername": "[parameters('linuxAdminUsername')]",
          "ssh": {
            "publicKeys": [
              {
                "keyData": "[parameters('sshRSAPublicKey')]"
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "controlPlaneFQDN": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName')), '2026-05-01').fqdn]"
    }
  }
}