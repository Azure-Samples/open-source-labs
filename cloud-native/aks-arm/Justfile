resource_group := env_var_or_default("RESOURCE_GROUP", "")

export RESOURCE_GROUP := resource_group
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"

default:
    @just --list

# Compile, check generated ARM, and preview the AKS deployment.
validate:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${RESOURCE_GROUP:?Set RESOURCE_GROUP to an existing validation resource group}"
    diff -u aks.json <(az bicep build --file aks.bicep --stdout)
    temp_dir="$(mktemp -d)"
    trap 'rm -f "$temp_dir/id_rsa" "$temp_dir/id_rsa.pub"; rmdir "$temp_dir"' EXIT
    ssh-keygen -q -t rsa -b 2048 -N '' -f "$temp_dir/id_rsa"
    az deployment group what-if \
        --resource-group "$RESOURCE_GROUP" \
        --template-file aks.bicep \
        --parameters \
            dnsPrefix=validate \
            linuxAdminUsername=azureuser \
            "sshRSAPublicKey=$(<"$temp_dir/id_rsa.pub")" \
        --no-pretty-print
