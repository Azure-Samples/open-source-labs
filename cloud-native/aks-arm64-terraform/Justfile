export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := "1"
resource_group := env_var_or_default("RESOURCE_GROUP", "")
export TF_VAR_resource_group_name := resource_group

default:
    @just --list

# Validate configuration and produce a non-mutating Terraform plan.
validate:
    terraform init -backend=false -input=false -lockfile=readonly
    terraform fmt -check
    terraform validate
    terraform plan -input=false -lock=false -refresh=false
